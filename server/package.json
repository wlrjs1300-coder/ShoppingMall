{
  "name": "tteokjip-server",
  "version": "1.0.0",
  "description": "따뜻한 떡집 API 서버",
  "main": "index.js",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "deploy:check": "node scripts/deployment-preflight.js",
    "staging:seed": "node scripts/seed-staging-synthetic.js",
    "staging:smoke": "node scripts/run-staging-smoke.js",
    "staging:rehearsal:check": "node scripts/staging-rehearsal-guard.js",
    "backup:create": "node scripts/backup-database.js",
    "backup:verify": "node scripts/verify-backup.js",
    "db:backup": "node scripts/backup-database.js",
    "pii:orders:dry-run": "node scripts/backfill-order-pii.js --dry-run",
    "pii:orders:verify": "node scripts/backfill-order-pii.js --verify",
    "pii:payments:dry-run": "node scripts/purge-payment-pii.js --dry-run",
    "pii:payments:verify": "node scripts/purge-payment-pii.js --verify",
    "user:promote": "node scripts/promote-user.js",
    "users:portfolio": "node scripts/seed-portfolio-users.js",
    "demo:seed": "node scripts/seed-demo.js",
    "portfolio:capture": "node scripts/capture-portfolio.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "supertest": "^7.2.2"
  }
}
