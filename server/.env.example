# Copy only the required keys to a local or deployment-platform environment.
# Never commit the real .env, JWT/Toss secrets, authentication codes, or provider secrets.

# Runtime
NODE_ENV=development
# Local default is local. A deployed runtime must use staging or production.
APP_ENV=local
PORT=3000
PUBLIC_BASE_URL=https://your-domain.example
ALLOWED_ORIGIN=https://your-domain.example

# Persistent data (production: absolute paths outside this Git repository)
# Windows example: DB_PATH=D:\ShoppingMallData\shoppingmall.sqlite
# Linux example: DB_PATH=/var/lib/shoppingmall/shoppingmall.sqlite
# DB_PATH=/var/lib/shoppingmall/shoppingmall.sqlite
# BACKUP_DIR=/var/backups/shoppingmall
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_FILES=30

# Authentication secrets (production: secret manager, unique random values, 32+ bytes)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_CODE_PEPPER=replace-with-a-different-random-32-byte-secret
ADMIN_JWT_ISSUER=shoppingmall-admin
ADMIN_JWT_AUDIENCE=shoppingmall-admin-api
ADMIN_TOKEN_TTL=1h
ADMIN_LOGIN_RATE_MAX=5
ADMIN_LOGIN_RATE_WINDOW_MS=900000
# Production uses DB administrator accounts. Do not enable legacy login.
ALLOW_LEGACY_ADMIN_LOGIN=false
ADMIN_CODE=

# Public store information
STORE_NAME=매장명
STORE_PHONE=031-123-4567
STORE_HOURS=09:00 - 19:00
STORE_ADDRESS=실제 매장 주소
STORE_PARKING=주차 안내
STORE_URL=https://store.example

# Payments: disabled or toss. Production toss requires live keys and mock=false.
PAYMENT_MODE=disabled
TOSS_CLIENT_KEY=your-toss-client-key
TOSS_SECRET_KEY=your-toss-secret-key
TOSS_MOCK_MODE=false

# Notifications: none, sms, or kakao
NOTIFICATION_MODE=none
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
KAKAO_PLUS_FRIEND_ID=
KAKAO_TEMPLATE_ORDER=
KAKAO_TEMPLATE_READY=
KAKAO_TEMPLATE_REMIND=

# Password reset email: disabled or resend
EMAIL_MODE=disabled
RESEND_API_KEY=
PASSWORD_RESET_FROM=ShoppingMall <no-reply@your-domain.example>

# Optional social login. Set each provider's ID and secret together.
# Callback: {PUBLIC_BASE_URL}/api/auth/social/{google|kakao|naver}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Naver Commerce API (disabled by default)
# Never commit the real client secret. SELF accesses the application's own resources;
# SELLER requires NAVER_COMMERCE_ACCOUNT_ID for a seller's resources.
# Before production, grant only required API groups and register the calling IP.
# Never use production customer data in staging.
NAVER_COMMERCE_SYNC_ENABLED=false
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
NAVER_COMMERCE_AUTH_TYPE=SELF
NAVER_COMMERCE_ACCOUNT_ID=
NAVER_COMMERCE_API_BASE_URL=https://api.commerce.naver.com/external
NAVER_COMMERCE_REQUEST_TIMEOUT_MS=10000

# Development/test only. Never set these in production.
# PHONE_TEST_CODE=
# PASSWORD_RESET_TEST_TOKEN=
# ALLOW_PORTFOLIO_SEED=true
# Reserved for a follow-up staging seed script. Existing portfolio seeds do not use it.
# ALLOW_STAGING_SEED=true
# DEMO_USERNAME=portfolio_demo
# DEMO_EMAIL=demo@example.test
# DEMO_PASSWORD=
# CAPTURE_BASE_URL=http://localhost:3000
# CHROME_PATH=C:\path\to\chrome.exe

# Staging contract (documentation only; keep secrets in the platform secret manager):
# NODE_ENV=production
# APP_ENV=staging
# DB_PATH=/data/staging.sqlite
# BACKUP_DIR=/data/backups
# PUBLIC_BASE_URL=https://staging-host.invalid
# ALLOWED_ORIGIN=https://staging-host.invalid
# PAYMENT_MODE=disabled
# TOSS_MOCK_MODE=false
# NOTIFICATION_MODE=none
# EMAIL_MODE=disabled
# NAVER_COMMERCE_SYNC_ENABLED=false
# NAVER_ORDER_IMPORT_ENABLED=false
